APP_NAME="求人メディア"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- データベース --------------------------------------------------
# 本番は顧客ごとに独立した MySQL データベース(1環境 = 1DB)。
# テナント分離の仕組みは持たない(CLAUDE.md 3.7)。
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=kyujin
DB_USERNAME=kyujin
DB_PASSWORD=secret

# --- ドライバ ------------------------------------------------------
# 本番(エックスサーバー共有レンタル)に Redis はない。
# セッション・キュー・キャッシュは database / file のみを使うこと。
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# キューは database ドライバ固定。本番は常駐ワーカーを使えないため、
# cron で毎分 `php artisan queue:work --stop-when-empty --max-time=50` を実行する
# (TASKS.md T-15 / CLAUDE.md 4章)。通知メールは最大 1 分遅れて届く前提で運用する。
QUEUE_CONNECTION=database
CACHE_STORE=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- メール --------------------------------------------------------
# ローカルは mailpit(http://localhost:8025)で受信を確認する。
# 本番は SendGrid / Amazon SES などの外部 SMTP を使う(サーバ直送はしない)。
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="no-reply@example.jp"
MAIL_FROM_NAME="${APP_NAME}"

# --- Docker のポート(ローカル開発のみ) -----------------------------
APP_PORT=8080
DB_FORWARD_PORT=3307
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
VITE_PORT=5173

VITE_APP_NAME="${APP_NAME}"
